{
  "name": "Rewind",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [8000, 8080, 4317, 4318],
  "portsAttributes": {
    "8000": { "label": "Rewind", "onAutoForward": "notify" },
    "8080": { "label": "SigNoz", "onAutoForward": "notify" },
    "4317": { "label": "OTLP gRPC", "onAutoForward": "silent" },
    "4318": { "label": "OTLP HTTP", "onAutoForward": "silent" }
  },
  "postCreateCommand": "pip install -r requirements.txt && cp -n .env.example .env || true",
  "remoteEnv": {
    "FAKE_LLM": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
