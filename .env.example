# ---------------------------------------------------------------- telemetry
# Where the SDK ships traces, metrics, and logs. This is the SigNoz collector.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Set to 1 to skip OTel export entirely (tests, offline work).
REWIND_DISABLE_OTEL=0
REWIND_ENV=dev
REWIND_VERSION=0.1.0
REWIND_METRIC_INTERVAL_MS=10000

# Local append-only mirror of everything the SDK emits. Used as a fallback
# read path when SigNoz is unreachable, so the UI is never dead.
REWIND_MIRROR_PATH=.rewind/telemetry.jsonl

# ----------------------------------------------------------------- privacy
REWIND_MAX_FIELD_BYTES=8000
# Comma separated extra keys to redact, on top of the built-in list.
# REWIND_REDACT_KEYS=customer_email,phone

# ------------------------------------------------------------ replay limits
REWIND_MAX_STEPS=40
REWIND_REPLAY_TIMEOUT_S=60

# --------------------------------------------------------------------- llm
# FAKE_LLM=1 runs the whole demo with a deterministic offline model.
# No API key, no network. This is the default so the project always runs.
FAKE_LLM=1

# --- real model, option A: Google AI Studio (recommended) -------------------
# Free key: https://aistudio.google.com/apikey
# Set FAKE_LLM=0 above, then uncomment these two lines.
# GEMINI_API_KEY=
# REWIND_MODEL=gemma-4-31b-it
# Other AI Studio choices: gemma-4-26b-a4b-it, gemini-2.0-flash
# REWIND_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- real model, option B: any OpenAI compatible endpoint -------------------
# Works with Groq, OpenAI, vLLM, Ollama, LM Studio, and friends.
# GROQ_API_KEY=
# REWIND_MODEL=llama-3.3-70b-versatile
# REWIND_LLM_BASE_URL=https://api.groq.com/openai/v1

# Force a provider instead of auto detecting. One of: fake, gemini, openai.
# REWIND_LLM_PROVIDER=
REWIND_LLM_TIMEOUT=30
REWIND_LLM_RETRIES=3
# Set to 1 to quietly use the offline model if a real call fails mid demo.
# Off by default: a silent downgrade hides a broken key.
REWIND_LLM_FALLBACK_TO_FAKE=0
# Cost modelling for models not in the built-in price table, USD per million.
# REWIND_PRICE_IN=0.08
# REWIND_PRICE_OUT=0.16

# Verify a real model works and the demo is deterministic:
#   python scripts/llm_check.py

# ------------------------------------------------------------------ signoz
# auto = prefer SigNoz, fall back to the mirror. Other values: signoz, mirror.
REWIND_BACKEND=auto
SIGNOZ_URL=http://localhost:8080
# In Codespaces set this to your forwarded 8080 URL so trace links open correctly.
# SIGNOZ_UI_URL=https://your-codespace-8080.app.github.dev
# Create one in SigNoz under Settings -> Service Accounts -> Keys.
SIGNOZ_API_KEY=
SIGNOZ_TRACE_PATH=/api/v1/traces/{trace_id}
SIGNOZ_QUERY_PATH=/api/v4/query_range
SIGNOZ_HEALTH_PATH=/api/v1/health
SIGNOZ_LOOKBACK_MINUTES=720
SIGNOZ_TIMEOUT_S=10
